{
  "scene": "research",
  "model": {
    "default_name": "codex-local",
    "allowed_names": [
      "codex-local",
      "mimo-v2.5-pro-thinking",
      "mimo-v2.5-pro-thinking-plan",
      "mimo-v2.5-pro-thinking-plan-sg",
      "deepseek-v4-flash-thinking",
      "deepseek-v4-pro-thinking",
      "qwen-plus-thinking",
      "ollama",
      "gpt-5.4-thinking",
      "claude-sonnet-4-6-thinking",
      "gemini-2.5-flash-thinking"
    ],
    "temperature_profile": "interactive"
  },
  "runtime": {
    "agent": {
      "max_iterations": 40
    },
    "runner": {
      "tool_timeout_seconds": 90.0
    }
  },
  "version": "v1",
  "description": "问题驱动的通用投研场景",
  "extends": [],
  "conversation": {
    "enabled": true
  },
  "tool_selection": {
    "mode": "select",
    "tool_tags_any": [
      "research",
      "web",
      "fins"
    ]
  },
  "defaults": {
    "missing_fragment_policy": "error"
  },
  "fragments": [
    {
      "id": "base_agents",
      "type": "AGENTS",
      "path": "base/agents.md",
      "required": true,
      "order": 100
    },
    {
      "id": "base_soul",
      "type": "SOUL",
      "path": "base/soul.md",
      "required": true,
      "order": 200
    },
    {
      "id": "base_fact_rules",
      "type": "SOUL",
      "path": "base/fact_rules.md",
      "required": true,
      "order": 300
    },
    {
      "id": "base_tools",
      "type": "TOOLS",
      "path": "base/tools.md",
      "required": true,
      "order": 400
    },
    {
      "id": "research_scene",
      "type": "SCENE",
      "path": "scenes/research.md",
      "required": true,
      "order": 500
    }
  ],
  "context_slots": [
    "research_method",
    "research_context",
    "base_user"
  ]
}
